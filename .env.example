# Opção 1: URL completa de conexão
# ROTAS_DATABASE_URL=postgresql+psycopg://postgres:senha@localhost:5432/rotas

# Opção 2: variáveis separadas (usadas quando ROTAS_DATABASE_URL não existe)
ROTAS_DB_HOST=localhost
ROTAS_DB_PORT=5432
ROTAS_DB_NAME=rotas
ROTAS_DB_USER=postgres
ROTAS_DB_PASSWORD=

# Mostra o SQL gerado no terminal (1 = liga)
ROTAS_SQL_ECHO=0
